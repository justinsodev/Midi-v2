{
  "name": "midi-v2", "version": "0.1.0", "private": true, "type": "module",
  "scripts": {
    "dev": "concurrently -k \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build",
    "start": "node --env-file-if-exists=.env --import tsx server/index.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run build && npm test && npm run test:e2e"
  },
  "dependencies": {
    "@fastify/static": "^8.3.0", "@fastify/websocket": "^11.2.0", "fastify": "^5.6.0",
    "react": "^19.2.0", "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0", "@types/node": "^22.18.0", "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0", "@types/ws": "^8.18.0", "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0", "tsx": "^4.20.0", "typescript": "^5.9.0", "vite": "^7.1.0", "vitest": "^3.2.0"
  }
}
