# Copy to .env. npm start reads this file automatically.
HOST=127.0.0.1
PORT=3333
STUN_URLS=stun:stun.l.google.com:19302
# Set these for forced TURN and restrictive remote networks.
# TURN_URLS=turn:turn.your-domain.example:3478?transport=udp
# TURN_SECRET=replace-with-a-long-random-secret
# Use your real HTTPS origin when deployed.
# ALLOWED_ORIGINS=https://studio.your-domain.example
